[Unit]
Description=SSH2FA daemon — keeps warm SSH ControlMasters so ssh needs no 2FA
Documentation=https://github.com/gasvn/ssh2fa
# The daemon needs the session D-Bus for the Secret Service credential store.
# Harmless when SSH2FA_VAULT=file: the dependency is a wants, not a requires.
Wants=dbus.socket
After=dbus.socket

[Service]
Type=simple
ExecStart=%h/.local/bin/ssh2fa-daemon

# Credential store. The default (unset) is the freedesktop Secret Service.
# A headless server has no keyring collection — PAM only creates one at a
# graphical login — so an SSH-only box must opt into the owner-only file vault:
#   systemctl --user edit ssh2fa-daemon    →    [Service]
#                                               Environment=SSH2FA_VAULT=file
# See docs/LINUX.md for what that does and does not protect.
#Environment=SSH2FA_VAULT=file

# WHY SIGKILL: a graceful stop makes the daemon run teardown_all, which closes
# every ControlMaster it owns — so `systemctl --user restart` would drop the
# user's warm SSH sessions and force a fresh 2FA login on the next connect.
# SIGKILL leaves the masters running (they are detached mux processes, not
# children); the next start ADOPTS them and nobody re-authenticates.
#
# Nothing is leaked by skipping the graceful path: the flock is released by the
# kernel, the next start removes the stale socket, and cleanup_orphans reaps
# stray tunnel processes at boot.
KillSignal=SIGKILL
FinalKillSignal=SIGKILL
SendSIGKILL=yes

# Match launchd's KeepAlive{SuccessfulExit:false} + ThrottleInterval 10.
Restart=on-failure
RestartSec=10

# The daemon is a long-lived supervisor of short-lived ssh children; letting
# systemd kill the cgroup on stop would take the ControlMasters with it and
# defeat the SIGKILL choice above.
KillMode=process

# Hardening is deliberately MINIMAL here, because the obvious settings each
# break a feature outright. Every line below is the result of one:
#
# * NOT NoNewPrivileges — it breaks sshfs mounts completely. `fusermount3` is
#   setuid root (that is how an unprivileged user is allowed to mount FUSE at
#   all), and NoNewPrivileges makes the kernel refuse the setuid transition, so
#   every mount fails with "fusermount3: mount failed: Operation not permitted".
#   Verified on Ubuntu 24.04: identical command, only this flag differing.
# * NOT PrivateDevices / ProtectKernelTunables / ProtectControlGroups — they
#   need mount-namespace privileges the per-user systemd instance does not
#   have, and the service dies at exec with `status=218/CAPABILITIES`, before a
#   single line of our code runs.
# * NOT ProtectHome / PrivateTmp — the daemon's whole job is reading ~/.ssh,
#   writing ~/.ssh2fa, mounting under ~/Mounts and driving ControlPath sockets
#   under $HOME; the per-slot ssh logs live in /tmp.
#
# * NOT RestrictSUIDSGID — it looks unrelated (it restricts CREATING suid
#   files, not executing them) but systemd documents it as IMPLYING
#   NoNewPrivileges=yes, so setting it silently re-enables the flag above and
#   breaks mounts again. Confirmed the hard way: with the unit saying
#   `NoNewPrivileges=no`, /proc/<pid>/status still showed `NoNewPrivs: 1`
#   until this line was removed too.
#
# So: no sandboxing directives at all. The daemon runs with exactly the
# privileges of the user who started it, which is what mounting FUSE requires.

[Install]
WantedBy=default.target
