      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改密码"
          }
        }
      }
    },
    "Changing a port reconnects this tunnel on the new port.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改端口会让此隧道在新端口上重新连接。"
