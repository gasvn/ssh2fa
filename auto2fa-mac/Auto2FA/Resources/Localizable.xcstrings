            "value": "取消固定 %@"
          }
        }
      }
    },
    "Up one level": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上一级"
          }
        }
      }
    },
    "Update & Relaunch": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新并重启"
          }
        }
