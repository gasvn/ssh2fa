          }
        }
      }
    },
    "Add SSH host": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加 SSH 主机"
          }
        }
      }
    },
    "Add a folder you work in — mounting it takes you straight there.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加你常用的文件夹——挂载后可直接进入。"
          }
        }
      }
    },
    "Add a host (register SSH + 2FA)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加主机（注册 SSH + 2FA）"
          }
        }
      }
    },
    "Add a host manually": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手动添加主机"
          }
        }
      }
    },
    "Add a tunnel": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加隧道"
          }
        }
      }
    },
    "Add from ~/.ssh/config": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 ~/.ssh/config 添加"
          }
        }
      }
    },
    "Advanced": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高级"
          }
        }
      }
    },
    "After Mac sleeps, the underlying TCP for every SSH master dies. Recommended on — without it tunnels silently break with no automatic recovery.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 睡眠后，每个 SSH 主连接底层的 TCP 都会断开。建议开启 —— 否则隧道会无声中断且不会自动恢复。"
          }
        }
      }
    },
    "Always-on notch status (experimental)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "常驻灵动岛状态（实验性）"
          }
        }
      }
    },
    "Appended after `http://localhost:%lld` when you click 🧭 or auto-open fires. Use this for jupyter `?token=…`, tensorboard `/#scalars`, etc.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击 🧭 或自动打开时，会附加在 `http://localhost:%lld` 之后。适合 jupyter 的 `?token=…`、tensorboard 的 `/#scalars` 等。"
          }
        }
      }
    },
    "Applies the next time this tunnel starts.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将在此隧道下次启动时生效。"
          }
        }
      }
    },
    "Ask the daemon for the next unused local port": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向后台助手请求下一个未占用的本地端口"
          }
        }
      }
    },
    "Ask the first time": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首次使用时询问"
          }
        }
      }
    },
    "Asks for Touch ID (or your Mac password) first": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会先要求 Touch ID（或你的 Mac 密码）"
          }
        }
      }
    },
    "Asks for Touch ID (or your Mac password) first. Use it to set up the same account in another authenticator.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会先要求 Touch ID（或你的 Mac 密码）。可用它在另一个验证器 App 中设置同一账户。"
          }
        }
      }
    },
    "Authenticating…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在验证…"
          }
        }
      }
    },
    "Authentication was cancelled or failed. Try again, or quit.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验证已取消或失败。请重试，或退出。"
          }
        }
      }
    },
    "Authorize now": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即授权"
          }
        }
