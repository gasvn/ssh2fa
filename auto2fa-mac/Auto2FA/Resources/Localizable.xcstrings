    ":%lld": {},
    ":%lld (local) → :%lld (remote)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": ":%1$lld (local) → :%2$lld (remote)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": ":%lld（本地）→ :%lld（远程）"
          }
        }
      }
    },
    ":%lld → %@:%lld": {
      "localizations": {
        "en": {
