      }
    },
    "No registered hosts yet — add a host first, then forward a port to it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有已注册的主机 —— 请先添加主机，再向它转发端口。"
          }
        }
      }
    },
    "No running jobs found. Use a custom node, or start a SLURM job first.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有找到运行中的作业。请使用自定义节点，或先启动一个 SLURM 作业。"
          }
        }
      }
    },
    "No sub-folders here — “Pin this folder” to pin it as-is.": {
      "localizations": {
        "zh-Hans": {
