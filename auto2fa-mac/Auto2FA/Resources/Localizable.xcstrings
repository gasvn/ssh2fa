    "via %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "经由 %@"
          }
        }
      }
    },
    "your login name": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的登录名"
          }
        }
      }
    },
    "your login name on the server": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你在服务器上的登录名"
          }
        }
      }
    },
    "“%@” isn't a Host in ~/.ssh/config": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”不是 ~/.ssh/config 中的 Host"
          }
        }
      }
    },
    "•• ••": {},
    "→ %@": {},
    "SSH2FA couldn't start. Quit and reopen the app, then use Troubleshoot if the problem continues.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH2FA 无法启动。请退出并重新打开应用；如果问题仍然存在，请使用“故障排查”。"
          }
        }
      }
    },
    "Restore connections": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复连接"
          }
        }
      }
    },
    "check hosts and restore interrupted connections": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查主机并恢复中断的连接"
          }
        }
      }
    },
    "stop tunnels and reconnect every host": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止隧道并重新连接所有主机"
          }
        }
      }
    },
    "Restore host connections and tunnels after wake": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "唤醒后恢复主机连接和隧道"
          }
        }
      }
    },
    "Sleep can interrupt long-running SSH connections. Recommended on — SSH2FA checks and restores them automatically when your Mac wakes.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠可能中断长时间运行的 SSH 连接。建议开启 —— Mac 唤醒时，SSH2FA 会自动检查并恢复连接。"
          }
        }
      }
    },
    "With auto-connect on, SSH2FA restores this host connection automatically after login, restart, or network recovery.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启自动连接后，SSH2FA 会在登录、重启或网络恢复后自动恢复这台主机的连接。"
          }
        }
      }
    },
    "Choose the next unused local port": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择下一个未使用的本地端口"
          }
        }
      }
    },
    "Restoring connections…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在恢复连接…"
          }
        }
      }
    },
    "checking hosts and tunnels": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在检查主机和隧道"
          }
        }
      }
    },
    "SSH2FA is still starting or recovering. Wait a moment and try again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH2FA 仍在启动或恢复中。请稍等片刻后重试。"
          }
        }
      }
    },
    "⚠︎ This Mac can't evaluate Touch ID or a login password right now — the lock may not engage.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠︎ 这台 Mac 目前无法验证 Touch ID 或登录密码 —— 锁定可能不会生效。"
          }
        }
      }
    },
    "⚠︎ iCloud Drive isn't available — turn it on in System Settings to sync.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠︎ iCloud 云盘不可用 —— 请在系统设置中开启以进行同步。"
          }
        }
      }
    },
    "Approve any macOS confirmation that appears, then keep this window open until setup completes.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请批准出现的 macOS 确认，然后保持此窗口打开，直到设置完成。"
          }
        }
      }
    },
    "Automatic connections are ready": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动连接已就绪"
          }
        }
      }
    },
    "Complete this once so future launches, reconnects, and updates don't ask for your Mac password again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只需完成一次，以后启动、重连和更新都不会再要求输入 Mac 密码。"
          }
        }
      }
    },
    "Continue": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续"
          }
        }
      }
    },
    "Current SSH connections keep running while the update finishes.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新期间，当前 SSH 连接会继续运行。"
          }
        }
      }
    },
    "Designed to prevent future password prompts": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "避免以后再次弹出密码提示"
          }
        }
      }
    },
    "Finish a one-time security update": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成一次性安全更新"
          }
        }
      }
    },
    "Finish update": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成更新"
          }
        }
      }
    },
    "Finishing securely…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在安全完成…"
          }
        }
      }
    },
    "Not now": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂不"
          }
        }
      }
    },
    "Older installations may show more than one macOS confirmation because each saved login was protected separately. Approve each one; this is the final time.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "较早的版本会分别保护每个已保存登录，因此 macOS 可能显示多次确认。请逐一批准；这是最后一次。"
          }
        }
      }
    },
    "One-time security update": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次性安全更新"
          }
        }
      }
    },
    "Securing saved logins": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在保护已保存的登录信息"
          }
        }
      }
    },
    "Setup complete": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置完成"
          }
        }
      }
    },
    "Setup wasn't completed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置尚未完成"
          }
        }
      }
    },
    "SSH2FA couldn't finish the security update. No saved login was lost. Approve the macOS confirmation and try again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH2FA 未能完成安全更新。已保存的登录信息没有丢失。请批准 macOS 确认后重试。"
          }
        }
      }
    },
    "SSH2FA improved how saved logins are protected. Finish this update once, and normal connections will stay automatic and quiet.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH2FA 改进了已保存登录信息的保护方式。完成这一次更新后，日常连接会保持自动且安静。"
          }
        }
      }
    },
    "This can take a minute on older installations": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "较早的安装可能需要一分钟"
          }
        }
      }
    },
    "Try again": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试"
          }
        }
      }
    },
    "You can try again now or continue using SSH2FA and finish after the next launch.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以现在重试，也可以继续使用 SSH2FA，并在下次启动后完成。"
          }
        }
      }
    },
    "You do not need to enter an SSH password or a 2FA code again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需再次输入 SSH 密码或 2FA 验证码。"
          }
        }
      }
    },
    "Your saved login is ready. Future launches, reconnects, and updates should not ask for your Mac password again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存的登录信息已就绪。以后启动、重连和更新都不应再要求输入 Mac 密码。"
          }
        }
      }
    },
    "Your saved logins are ready. Future launches, reconnects, and updates should not ask for your Mac password again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存的登录信息已就绪。以后启动、重连和更新都不应再要求输入 Mac 密码。"
          }
        }
      }
    },
    "Your saved logins are unchanged": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存的登录信息未发生变化"
          }
        }
      }
    },
    "Your SSH password and 2FA secret stay protected on this Mac.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 密码和 2FA 密钥会安全保存在这台 Mac 上。"
          }
        }
      }
    },
    "An older version saved each login separately. Review the one-time migration so future launches, reconnects, and updates stay automatic without Mac password prompts.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旧版本会分别保存每个登录信息。请先查看这次一次性迁移；完成后，启动、重连和更新会保持自动进行，不再弹出 Mac 密码提示。"
          }
        }
      }
    },
    "Approve each macOS confirmation that appears, then keep this migration window open until it completes.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请逐一批准出现的 macOS 确认，并保持迁移窗口打开直到完成。"
          }
        }
      }
    },
    "Current SSH connections keep running while the migration finishes.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "迁移期间，当前 SSH 连接会继续运行。"
          }
        }
      }
    },
    "If you have several saved logins, macOS may show more than one confirmation because the old items were protected separately. Approve each one; this is the final migration.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果保存了多个登录信息，由于旧项目是分别保护的，macOS 可能显示多次确认。请逐一批准；这是最后一次迁移。"
          }
        }
      }
    },
    "Migrate saved logins": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "迁移已保存的登录信息"
          }
        }
      }
    },
    "Migrating saved logins": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在迁移已保存的登录信息"
          }
        }
      }
    },
    "Migration in progress…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在迁移…"
          }
        }
      }
    },
    "Moving old saved logins into the new protected format": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在将旧登录信息迁移到新的安全格式"
          }
        }
      }
    },
    "Older SSH2FA versions saved each login separately. This migration moves them into the new protected format so future updates stay quiet.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旧版 SSH2FA 会分别保存每个登录信息。这次迁移会将它们移到新的安全格式中，让以后的更新不再弹出密码提示。"
          }
        }
      }
    },
    "One-time migration from an older SSH2FA version": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自旧版 SSH2FA 的一次性迁移"
          }
        }
      }
    },
    "Review migration": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看迁移说明"
          }
        }
      }
    },
    "SSH2FA couldn't finish migrating your saved logins. Nothing was lost. Approve the macOS migration confirmation and try again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH2FA 未能完成已保存登录信息的迁移。没有任何数据丢失。请批准 macOS 的迁移确认后重试。"
          }
        }
      }
    },
    "Start migration": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始迁移"
          }
        }
      }
    },
    "The macOS password dialog that may appear next is authorizing SSH2FA to read and migrate logins saved by older versions. It is not an SSH login. Your Mac password goes only to macOS; SSH2FA never receives it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接下来可能出现的 macOS 密码框，是在授权 SSH2FA 读取并迁移旧版本保存的登录信息，并不是在登录 SSH 服务器。你的 Mac 密码只会交给 macOS，SSH2FA 无法看到。"
          }
        }
      }
    },
    "Why macOS may ask for your password": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为什么 macOS 可能要求输入密码"
          }
        }
      }
    },
    "2FA secret (optional — otpauth:// URL or secret key)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两步验证密钥（可选 —— otpauth:// 链接或密钥串）"
          }
        }
      }
    },
    "leave empty if this account has no 2FA": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该账号没有两步验证就留空"
          }
        }
      }
    },
    "Only fill this in if the server asks for a verification code. It needs a TOTP secret key — **not Duo Push** (approve-on-phone). Paste the otpauth:// URL or the bare base32 secret, or screenshot the QR and click “Scan QR”.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有当服务器会要求输入验证码时才需要填。需要 TOTP 密钥 —— **不是 Duo Push**（手机点确认那种）。粘贴 otpauth:// 链接或纯 base32 密钥，或者截图二维码后点“扫描二维码”。"
          }
        }
      }
    },
    "No 2FA on this account? Leave it empty — you can add a secret later in Password & setup.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账号没有两步验证？留空即可 —— 以后可以在“密码与设置”里补上密钥。"
          }
        }
      }
    },
    "2FA secret: ": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两步验证密钥："
          }
        }
      }
    },
    "none — this host signs in with a password only": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无 —— 此主机只用密码登录"
          }
        }
      }
    },
    "No 2FA secret stored — this host signs in with a password only": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未保存两步验证密钥 —— 此主机只用密码登录"
          }
        }
      }
    },
    "If the server starts asking for a verification code, add the secret below.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果服务器开始要求输入验证码，在下面添加密钥即可。"
          }
        }
      }
    },
    "Remove 2FA secret": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除两步验证密钥"
          }
        }
      }
    },
    "For an account that no longer uses 2FA — logins will use the password alone.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适用于不再使用两步验证的账号 —— 登录将只用密码。"
          }
        }
      }
    },
    "Add a host (SSH password, plus a 2FA secret if the server asks for codes)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加主机（SSH 密码；若服务器要验证码，再加两步验证密钥）"
          }
        }
      }
    }
  },
  "version": "1.0"
}
