            "state": "translated",
            "value": "本地"
          }
        }
      }
    },
    "Local port": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地端口"
          }
        }
      }
    },
    "Locks the dashboard and log windows behind Touch ID (falls back to your Mac login password). The menu-bar icon stays visible. Re-locks ~60s after you close the window.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 Touch ID 锁定面板和日志窗口（可回退到 Mac 登录密码）。菜单栏图标仍然可见。关闭窗口约 60 秒后重新锁定。"
          }
        }
      }
    },
    "Log into your 2FA-protected SSH hosts once, then stay connected — SSH2FA types your TOTP code for you every time you ssh.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录一次受 2FA 保护的 SSH 主机，然后保持连接 —— 每次 ssh 时 SSH2FA 都替你输入 TOTP 验证码。"
          }
        }
      }
    },
    "Login failed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录失败"
          }
        }
      }
    },
    "Login rejected — password or OTP is wrong. Re-add the host to fix.": {
