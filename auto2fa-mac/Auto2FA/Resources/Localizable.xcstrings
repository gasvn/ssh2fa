{
  "sourceLanguage": "en",
  "strings": {
    "": {},
    "\"%@\" is no longer a Host in ~/.ssh/config — it won't connect. Add it back to your config, or remove it from SSH2FA (⋯ → Remove Host…).": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”已不在 ~/.ssh/config 中 —— 无法连接。请加回配置文件，或从 SSH2FA 移除（⋯ → 移除主机…）。"
          }
        }
      }
    },
    "%@ is available": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 可用"
          }
        }
      }
    },
    "%@ — click ⋯ → Open in Finder": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ —— 点 ⋯ → 在访达中打开"
          }
        }
      }
    },
    "%lld": {},
    "%lld failed connection attempt%@": {
      "localizations": {
