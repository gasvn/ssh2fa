    "Filter by job, partition, name, node…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按作业、分区、名称、节点筛选…"
          }
        }
      }
    },
    "For best reliability, drag SSH2FA.app to /Applications first — SMAppService remembers the bundle path at register time, so moving the .app later silently breaks the auto-launch.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为获得最佳可靠性，请先把 SSH2FA.app 拖到 /Applications —— SMAppService 会记住注册时的路径，之后移动 .app 会让自动启动静默失效。"
          }
        }
      }
    },
    "Force-unmount everything (if stuck)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "强制卸载全部（卡住时使用）"
          }
        }
      }
    },
    "Found %lld host(s) in your ~/.ssh/config": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 ~/.ssh/config 中找到 %lld 个主机"
          }
