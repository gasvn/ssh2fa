    "Save your changes first — the test uses the stored credentials.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先保存更改 —— 测试使用的是已存储的凭据。"
          }
        }
      }
    },
